  "components": [
    {
      "name": "Choice Tile",
      "kind": "card",
      "refersTo": "choice-tile",
      "description": "Default flat tile, with a selected sibling.",
      "html": "<div class=\"ds-tiles\"><label class=\"ds-tile\"><span class=\"ds-ic\"><svg class=\"ds-svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><polygon points=\"12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2\"/></svg></span><span class=\"ds-title\">Hot</span><span class=\"ds-sub\">Ready to buy</span></label><label class=\"ds-tile ds-tile-sel\"><span class=\"ds-check\"><svg class=\"ds-svg-sm\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><polyline points=\"20 6 9 17 4 12\"/></svg></span><span class=\"ds-ic\"><svg class=\"ds-svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"4\"/><path d=\"M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41\"/></svg></span><span class=\"ds-title\">Warm</span><span class=\"ds-sub\">Interested</span></label></div>",
      "css": ".ds-tiles{display:flex;gap:8px}.ds-tile{position:relative;display:flex;flex-direction:column;align-items:center;gap:8px;width:120px;padding:16px;background:#fff;border:1px solid #c9c9c9;border-radius:8px;color:#181818;text-align:center;box-sizing:border-box;cursor:pointer;transition:border-color 160ms cubic-bezier(.2,.8,.2,1),background-color 160ms cubic-bezier(.2,.8,.2,1)}.ds-tile:hover{border-color:#747474}.ds-tile-sel,.ds-tile-sel:hover{border-color:#0176d3;background:#eaf3ff}.ds-ic{display:inline-flex;align-items:center;justify-content:center;width:40px;height:40px;border:1px solid #c9c9c9;border-radius:50%;color:#5c5c5c}.ds-tile-sel .ds-ic{color:#0176d3;border-color:#0176d3}.ds-title{font-size:14px;font-weight:600;line-height:1.25}.ds-sub{font-size:12px;color:#5c5c5c;line-height:1.25}.ds-check{position:absolute;top:8px;right:8px;width:24px;height:24px;border-radius:50%;background:#0176d3;color:#fff;display:flex;align-items:center;justify-content:center;box-shadow:0 0 0 2px #fff}.ds-tile:focus-within{outline:2px solid #0b5cab;outline-offset:2px}.ds-svg{width:20px;height:20px}.ds-svg-sm{width:14px;height:14px}"
    },
    {
      "name": "Raised Tile",
      "kind": "card",
      "refersTo": "choice-tile",
      "description": "Tile with Raised elevation; lifts on hover.",
      "html": "<label class=\"ds-raised\"><span class=\"ds-title\">Raised</span><span class=\"ds-sub\">Hover to lift</span></label>",
      "css": ".ds-raised{display:flex;flex-direction:column;align-items:center;gap:4px;width:140px;padding:16px;background:#fff;border:1px solid #c9c9c9;border-radius:8px;box-shadow:0 2px 12px rgba(24,24,24,.10);color:#181818;cursor:pointer;transition:box-shadow 200ms cubic-bezier(.2,.8,.2,1),transform 180ms cubic-bezier(.2,.8,.2,1),border-color 160ms cubic-bezier(.2,.8,.2,1)}.ds-raised:hover{border-color:#747474;box-shadow:0 8px 20px rgba(24,24,24,.13);transform:translateY(-1px)}.ds-title{font-size:14px;font-weight:600}.ds-sub{font-size:12px;color:#5c5c5c}"
    },
    {
      "name": "Tile Badge",
      "kind": "chip",
      "refersTo": "tile-badge",
      "description": "Uppercase status badge shown on tiles.",
      "html": "<span class=\"ds-badge\">New</span> <span class=\"ds-badge ds-badge-brand\">Popular</span>",
      "css": ".ds-badge{display:inline-flex;align-items:center;padding:4px 8px;background:#f3f3f3;color:#444;border-radius:999px;box-shadow:inset 0 0 0 1px #e5e5e5;font-size:11px;font-weight:700;line-height:1;letter-spacing:.06em;text-transform:uppercase}.ds-badge-brand{background:#eaf3ff;color:#014486;box-shadow:inset 0 0 0 1px #0b5cab}"
    },
    {
      "name": "Search Bar",
      "kind": "input",
      "refersTo": "search-bar",
      "description": "Inline filter above a tile group.",
      "html": "<div class=\"ds-search\"><input class=\"ds-search-input\" placeholder=\"Search options\" /></div>",
      "css": ".ds-search{display:flex;align-items:center;gap:8px;padding:8px 12px;border:1px solid #c9c9c9;border-radius:8px;background:#fff;width:240px;box-sizing:border-box}.ds-search-input{flex:1;border:0;outline:none;background:transparent;font-size:14px;color:#181818}.ds-search:focus-within{border-color:#0176d3;box-shadow:0 0 0 2px #eaf3ff}"
    },
    {
      "name": "On/Off Toggle",
      "kind": "custom",
      "refersTo": "segmented-option-on",
      "description": "Two-option segmented switch used across the studio.",
      "html": "<div class=\"ds-seg\"><button class=\"ds-seg-opt\">Off</button><button class=\"ds-seg-opt ds-seg-on\">On</button></div>",
      "css": ".ds-seg{display:inline-grid;grid-template-columns:1fr 1fr;padding:1px;border:1px solid #c9c9c9;border-radius:12px;background:#f3f3f3;box-shadow:inset 0 1px 2px rgba(24,24,24,.08)}.ds-seg-opt{min-width:56px;min-height:24px;padding:0 12px;border:0;border-radius:11px;background:transparent;color:#444;font:inherit;font-size:12px;font-weight:700;line-height:1;cursor:pointer;transition:background-color 120ms cubic-bezier(.2,.8,.2,1),color 120ms cubic-bezier(.2,.8,.2,1)}.ds-seg-on{background:#0176d3;color:#fff;box-shadow:0 0 0 1px rgba(11,92,171,.75),0 1px 2px rgba(24,24,24,.12)}.ds-seg-opt:focus-visible{outline:2px solid #0b5cab;outline-offset:2px}"
    },
    {
      "name": "Tone Chip",
      "kind": "chip",
      "refersTo": "tone-chip",
      "description": "Color-tone picker chip; active inverts to ink with a brand ring.",
      "html": "<span class=\"ds-tone\"><i class=\"ds-dot\"></i>Brand</span> <span class=\"ds-tone ds-tone-on\"><i class=\"ds-dot ds-dot-violet\"></i>Violet</span>",
      "css": ".ds-tone{display:inline-flex;align-items:center;gap:6px;padding:3px 8px;background:#fff;border:1px solid #e5e5e5;border-radius:8px;font-size:11px;font-weight:600;color:#2e2e2e;line-height:1.25;cursor:pointer;transition:background-color 140ms,border-color 140ms}.ds-dot{width:8px;height:8px;border-radius:50%;background:#0176d3;display:inline-block}.ds-dot-violet{background:#6d42c1}.ds-tone:hover{background:#f3f3f3;border-color:#c9c9c9}.ds-tone-on,.ds-tone-on:hover{background:#181818;color:#fff;border-color:#181818;box-shadow:0 0 0 2px rgba(1,118,211,.45)}.ds-tone:focus-visible{outline:2px solid #0176d3;outline-offset:2px}"
    },
    {
      "name": "Studio Card",
      "kind": "card",
      "refersTo": "studio-card",
      "description": "Editor section card: flat hairline, 12px radius, soft header band.",
      "html": "<section class=\"ds-card\"><header class=\"ds-card-head\"><h3 class=\"ds-card-title\">Card surface</h3><p class=\"ds-card-sub\">Elevation, surface style and tones per state.</p></header><div class=\"ds-card-body\">Controls</div></section>",
      "css": ".ds-card{background:#fff;border:1px solid #e5e5e5;border-radius:12px;width:300px;box-sizing:border-box}.ds-card-head{display:flex;flex-wrap:wrap;align-items:baseline;column-gap:8px;padding:8px 12px;background:#f9f9f9;border-bottom:1px solid #e5e5e5;border-radius:12px 12px 0 0}.ds-card-title{margin:0;font-size:14px;font-weight:700;color:#181818;line-height:1.25}.ds-card-sub{margin:0;font-size:12px;color:#5c5c5c;line-height:1.375}.ds-card-body{padding:12px;font-size:13px;color:#5c5c5c}"
    },
    {
      "name": "Bulk Edit Card",
      "kind": "card",
      "refersTo": "studio-card",
      "description": "Brand-tinted action panel with a 3px brand leading rule, shown while options are selected.",
      "html": "<section class=\"ds-bulk\"><header class=\"ds-bulk-head\">Edit 3 selected options</header><div class=\"ds-bulk-body\">Shared override fields</div></section>",
      "css": ".ds-bulk{width:300px;box-sizing:border-box;border:1px solid color-mix(in oklab,#0176d3 35%,#e5e5e5);border-inline-start:3px solid #0176d3;border-radius:12px;background:color-mix(in oklab,#0176d3 3%,#fff)}.ds-bulk-head{padding:8px 12px;background:color-mix(in oklab,#0176d3 8%,#fff);border-bottom:1px solid #e5e5e5;border-radius:12px 12px 0 0;font-size:14px;font-weight:700;color:#181818}.ds-bulk-body{padding:12px;font-size:13px;color:#5c5c5c}"
    },
    {
      "name": "Override Row",
      "kind": "custom",
      "refersTo": "studio-card",
      "description": "Per-value override row; selected state tints head 12% and body 3% brand.",
      "html": "<div class=\"ds-row\"><div class=\"ds-row-head\">Hot</div></div><div class=\"ds-row ds-row-sel\"><div class=\"ds-row-head\">Warm</div><div class=\"ds-row-body\">Overrides</div></div>",
